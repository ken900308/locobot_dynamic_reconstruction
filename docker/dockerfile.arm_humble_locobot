# ROS2 Humble container for AGX Thor (ARM64)
FROM ros:humble-ros-base

# Set timezone and non-interactive mode
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Taipei

ENV QT_X11_NO_MITSHM=1
ENV PYTHONUNBUFFERED=1

RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Install dependencies for Python, GUI, and ROS tooling
# Note: Using python3-dev (Python 3.10) since base image is Ubuntu 22.04 (jammy)
RUN apt-get update && apt-get install -y \
    sudo \
    curl \
    gnupg2 \
    lsb-release \
    git \
    software-properties-common \
    wget \
    python3-dev \
    python3-venv \
    python3-pip \
    nano \
    build-essential \
    cmake \
    pkg-config \
    ccache \
    # GUI support
    x11-apps \
    mesa-utils \
    libgl1-mesa-dri \
    libglx-mesa0 \
    libglvnd0 \
    libglvnd-dev \
    libegl1 \
    libgles2 \
    libxrandr2 \
    libxinerama1 \
    libxcursor1 \
    libxi6 \
    libgtk-3-dev \
    # OpenCV/runtime deps for ROS tools
    libgl1 \
    libglib2.0-0 \
    libxext6 \
    libsm6 \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Install RealSense support if available, then remove repo to avoid breaking later apt-get update
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates gnupg curl libusb-1.0-0 lsb-release && \
    mkdir -p /etc/apt/keyrings && \
    rm -f /etc/apt/sources.list.d/librealsense.list && \
    curl -fsSL https://librealsense.intel.com/Debian/librealsense.pgp \
    | gpg --dearmor -o /etc/apt/keyrings/librealsense-archive-keyring.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/librealsense-archive-keyring.gpg] https://librealsense.intel.com/Debian/apt-repo $(lsb_release -cs) main" \
    > /etc/apt/sources.list.d/librealsense.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        librealsense2-utils \
        librealsense2-dev \
        librealsense2-gl || true && \
    rm -f /etc/apt/sources.list.d/librealsense.list && \
    rm -rf /var/lib/apt/lists/*
    
# Install ROS2 Humble tools and common message packages
RUN apt-get update && apt-get install -y \
    python3-rosdep \
    python3-colcon-common-extensions \
    ros-humble-cv-bridge \
    ros-humble-geometry-msgs \
    ros-humble-sensor-msgs \
    ros-humble-std-msgs \
    ros-humble-rclpy \
    ros-humble-rosbridge-server \
    ros-humble-foxglove-bridge \
    && rm -rf /var/lib/apt/lists/*

# Initialize rosdep (if not already done in base image)
RUN if [ ! -f /etc/ros/rosdep/sources.list.d/20-default.list ]; then rosdep init; fi && rosdep update || true

# Setup workspace
WORKDIR /workspace

# Source ROS setup in bashrc
RUN echo "source /opt/ros/humble/setup.bash" >> ~/.bashrc || true

# Set custom prompt for ROS container
RUN echo 'PS1="\[\e[1;34m\][ROS-Humble-locobot]\[\e[0m\] \w # "' >> ~/.bashrc
RUN echo "source /opt/ros/humble/setup.bash" >> ~/.bashrc || true
RUN echo "[ -f /workspace/thor/ros_ws/install/setup.bash ] && source /workspace/thor/ros_ws/install/setup.bash" >> ~/.bashrc || true

CMD ["/bin/bash"]