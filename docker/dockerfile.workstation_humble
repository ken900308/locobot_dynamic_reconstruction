# CUDA development container for this x86_64 workstation.
# Ubuntu 22.04 is paired with ROS 2 Humble.
FROM nvidia/cuda:12.8.1-devel-ubuntu22.04

ARG TARGET_CUDA_ARCH=12.0
ARG ROS_DISTRO=humble
ARG UBUNTU_CODENAME=jammy

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Taipei
ENV QT_X11_NO_MITSHM=1
ENV PYTHONUNBUFFERED=1
ENV FORCE_CUDA=1
ENV TORCH_CUDA_ARCH_LIST=${TARGET_CUDA_ARCH}
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}

RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

RUN apt-get update && apt-get install -y --no-install-recommends \
    sudo \
    ca-certificates \
    curl \
    gnupg2 \
    lsb-release \
    git \
    software-properties-common \
    wget \
    python3-dev \
    python3-venv \
    python3-pip \
    nano \
    build-essential \
    cmake \
    pkg-config \
    ccache \
    ninja-build \
    gfortran \
    autoconf \
    libtool \
    clang \
    x11-apps \
    mesa-utils \
    libglvnd0 \
    libglvnd-dev \
    libegl1 \
    libgles2 \
    libxrandr2 \
    libxinerama1 \
    libxcursor1 \
    libxi6 \
    libgtk-3-dev \
    libgl1 \
    libglib2.0-0 \
    libxext6 \
    libsm6 \
    ffmpeg \
    libblas-dev \
    liblapack-dev \
    liblapacke-dev \
    xorg-dev \
    libglu1-mesa-dev \
    libsdl2-dev \
    libc++-dev \
    libc++abi-dev \
    libpng-dev \
    libjpeg-dev \
    libxcb-shm0 \
    libtbb-dev \
    libosmesa6-dev \
    libudev-dev \
    libusb-1.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install RealSense apt packages when Intel publishes compatible packages.
RUN set -eux; \
    mkdir -p /etc/apt/keyrings; \
    curl -fsSL https://librealsense.intel.com/Debian/librealsense.pgp \
    | gpg --dearmor -o /etc/apt/keyrings/librealsense-archive-keyring.gpg; \
    echo "deb [signed-by=/etc/apt/keyrings/librealsense-archive-keyring.gpg] https://librealsense.intel.com/Debian/apt-repo $(lsb_release -cs) main" \
    > /etc/apt/sources.list.d/librealsense.list; \
    if apt-get update && apt-get install -y --no-install-recommends librealsense2-utils librealsense2-dev librealsense2-gl; then \
        echo "RealSense apt packages installed"; \
    else \
        echo "WARNING: RealSense apt repo unavailable; removing source list and continuing"; \
        rm -f /etc/apt/sources.list.d/librealsense.list /etc/apt/keyrings/librealsense-archive-keyring.gpg; \
        apt-get update; \
    fi; \
    rm -rf /var/lib/apt/lists/*

RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu ${UBUNTU_CODENAME} main" > /etc/apt/sources.list.d/ros2.list && \
    apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-ros-base \
    python3-rosdep \
    python3-colcon-common-extensions \
    ros-${ROS_DISTRO}-cv-bridge \
    ros-${ROS_DISTRO}-geometry-msgs \
    ros-${ROS_DISTRO}-sensor-msgs \
    ros-${ROS_DISTRO}-std-msgs \
    ros-${ROS_DISTRO}-rclpy \
    ros-${ROS_DISTRO}-rosbridge-server \
    ros-${ROS_DISTRO}-foxglove-bridge \
    && rm -rf /var/lib/apt/lists/*

RUN if [ ! -f /etc/ros/rosdep/sources.list.d/20-default.list ]; then rosdep init; fi && rosdep update || true

RUN printf "%s\n" \
    "/usr/local/cuda/lib64" \
    "/opt/hpcx/ucx/lib" \
    "/opt/hpcx/ucc/lib" \
    > /etc/ld.so.conf.d/cuda.conf && ldconfig || true

ENV LD_LIBRARY_PATH=/opt/hpcx/ucx/lib:/opt/hpcx/ucc/lib:${LD_LIBRARY_PATH}

RUN set -eux; \
    python3 --version; \
    nvcc --version || true

RUN python3 -m pip install --upgrade pip 'setuptools==70.0.0' 'packaging>=24.1' 'wheel>=0.43' ninja backports.tarfile

RUN printf '%s\n' \
    'torch==2.7.1' \
    'torchvision==0.22.1' \
    'torchaudio==2.7.1' \
    'numpy==1.26.4' \
    'opencv-python==4.8.1.78' \
    > /tmp/pip-constraints.txt
ENV PIP_CONSTRAINT=/tmp/pip-constraints.txt

RUN python3 -m pip install --no-cache-dir --force-reinstall --index-url https://download.pytorch.org/whl/cu128 \
    'torch==2.7.1' 'torchvision==0.22.1' 'torchaudio==2.7.1' && \
    python3 - <<'PYTORCHCHECK'
import torch
print('torch:', torch.__version__)
print('torch.version.cuda:', torch.version.cuda)
assert torch.__version__.startswith('2.7.1'), torch.__version__
assert torch.version.cuda == '12.8', torch.version.cuda
PYTORCHCHECK

# ROS Humble pulls some Python modules from apt/distutils.  Use
# --ignore-installed here so pip does not try to uninstall apt-owned packages
# such as python-dateutil during Open3D/evo dependency resolution.
RUN python3 -m pip install --ignore-installed --no-cache-dir \
    'numpy==1.26.4' \
    einops \
    efficientnet_pytorch \
    PyYAML \
    Pillow \
    prettytable \
    matplotlib \
    scipy \
    wandb \
    warmup_scheduler \
    roslibpy \
    'opencv-python==4.8.1.78' \
    'open3d==0.19.0' \
    'imgui[glfw,opengl3]==2.0.0' \
    plyfile \
    evo \
    natsort

RUN python3 -m pip install --no-cache-dir --no-deps 'Cython>=0.24,<0.30' PyOpenGL

RUN python3 -m pip install --no-cache-dir 'faiss-cpu==1.7.4' || \
    python3 -m pip install --no-cache-dir faiss-cpu || true

RUN python3 -m pip install --no-cache-dir pyrealsense2 || echo "WARNING: pyrealsense2 not available, skipping..."

RUN TORCH_CUDA_ARCH_LIST="${TARGET_CUDA_ARCH}" FORCE_CUDA=1 \
    python3 -m pip install --no-build-isolation --no-deps --no-cache-dir \
    'lietorch @ git+https://github.com/princeton-vl/lietorch.git'

WORKDIR /workspace
COPY thor/MASt3R-SLAM /workspace/thor/MASt3R-SLAM

RUN echo 'PS1="\[\e[1;34m\][locobot]\[\e[0m\] \w # "' >> ~/.bashrc

RUN set -eux; \
    cd /workspace/thor/MASt3R-SLAM/thirdparty/in3d/thirdparty/pyimgui; \
    python3 -m cython -I . -I imgui --cplus -o imgui/core.cpp imgui/core.pyx; \
    python3 -m cython -I . -I imgui --cplus -o imgui/internal.cpp imgui/internal.pyx; \
    ls -lh imgui/core.cpp imgui/core.h imgui/internal.cpp imgui/internal.h

RUN set -eux; \
    cd /workspace/thor/MASt3R-SLAM; \
    python3 -m pip install --no-build-isolation --no-deps -e thirdparty/mast3r/asmk; \
    python3 -m pip install --no-build-isolation --no-deps -e thirdparty/mast3r; \
    python3 -m pip install --no-build-isolation --no-deps -e thirdparty/in3d; \
    PIP_CONSTRAINT= TORCH_CUDA_ARCH_LIST="${TARGET_CUDA_ARCH}" FORCE_CUDA=1 \
    python3 -m pip install --no-build-isolation . --no-cache-dir --no-deps

RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> ~/.bashrc || true
RUN echo "if [ -f /workspace/thor/ros2_ws/install/setup.bash ]; then source /workspace/thor/ros2_ws/install/setup.bash; fi" >> ~/.bashrc || true

CMD ["/bin/bash"]
