# Configure library paths for CUDA and HPC-X (fix libucc undefined symbol issue)
RUN printf "%s\n" \
    "/usr/local/cuda/lib64" \
    "/opt/hpcx/ucx/lib" \
    "/opt/hpcx/ucc/lib" \
    > /etc/ld.so.conf.d/cuda.conf && ldconfig || true

# Set HPC-X paths in environment (fix libucc.so.1 undefined symbol error)
ENV LD_LIBRARY_PATH=/opt/hpcx/ucx/lib:/opt/hpcx/ucc/lib:${LD_LIBRARY_PATH}

# Sanity check: verify CUDA and PyTorch
RUN set -eux; \
    echo "== Python version =="; python3 --version; \
    echo "== CUDA dirs =="; ls -l /usr/local/cuda* || true; \
    echo "== PyTorch check =="; \
    python3 -c "import torch; print('PyTorch:', torch.__version__); print('CUDA available:', torch.cuda.is_available())" || true

# Install Python dependencies for the project (excluding open3d, pyrealsense2)
RUN pip install --no-cache-dir \
    'numpy<2' \
    einops \
    efficientnet_pytorch \
    PyYAML \
    Pillow \
    prettytable \
    matplotlib \
    scipy \
    wandb \
    warmup_scheduler \
    # roslibpy \
    opencv-python \
    "imgui[glfw,opengl3]==2.0.0"

# Install faiss-cpu (ARM64 wheels may be limited; allow fallback)
RUN pip install --no-cache-dir 'faiss-cpu==1.7.4' || \
    pip install --no-cache-dir faiss-cpu || true

# Build Open3D from source for ARM64 with CUDA support
# Reference: https://www.open3d.org/docs/release/arm.html
# Note: Skip install_deps_ubuntu.sh (uses sudo which doesn't exist in Docker)
RUN git clone --depth 1 --branch v0.19.0 https://github.com/isl-org/Open3D.git /tmp/Open3D && \
    cd /tmp/Open3D && \
    # Install remaining Open3D dependencies manually (without sudo)
    apt-get update && apt-get install -y --no-install-recommends \
    libxcb-shm0 libtbb-dev libosmesa6-dev libudev-dev autoconf libtool clang ninja-build gfortran && \
    rm -rf /var/lib/apt/lists/* && \
    # Build Open3D
    mkdir build && cd build && \
    cmake -DBUILD_CUDA_MODULE=OFF \
    -DBUILD_GUI=OFF \
    -DBUILD_SHARED_LIBS=ON \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_EXAMPLES=OFF \
    -DBUILD_UNIT_TESTS=OFF \
    -DBUILD_BENCHMARKS=OFF \
    .. && \
    make -j$(nproc) && \
    make install-pip-package && \
    cd / && rm -rf /tmp/Open3D

# Install pyrealsense2 (may not have ARM packages, allow failure)
RUN pip install --no-cache-dir pyrealsense2 || echo "WARNING: pyrealsense2 not available, skipping..."

# Upgrade packaging tools (same as x86 version)
RUN pip install --upgrade pip && \
    pip install --upgrade "setuptools>=70" "packaging>=24.1" "wheel>=0.43" ninja

# Setup workspace
WORKDIR /workspace
COPY thor/MASt3R-SLAM /workspace/thor/MASt3R-SLAM

# Set custom prompt for GPU container
RUN echo 'PS1="\[\e[1;32m\][GPU-Thor-locobot]\[\e[0m\] \w # "' >> ~/.bashrc

# Install MASt3R thirdparty deps and build extensions for SM 11.0
RUN set -eux; \
    cd /workspace/thor/MASt3R-SLAM; \
    pip install --no-build-isolation -e thirdparty/mast3r/asmk; \
    pip install --no-build-isolation -e thirdparty/mast3r; \
    TORCH_CUDA_ARCH_LIST="11.0" FORCE_CUDA=1 pip install --no-build-isolation . --no-cache-dir

# Source ROS setup in bashrc
# RUN echo "source /opt/ros/jazzy/setup.bash" >> ~/.bashrc || true

CMD ["/bin/bash"]