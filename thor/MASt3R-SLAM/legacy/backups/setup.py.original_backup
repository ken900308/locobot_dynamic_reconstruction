
# ===== MONKEY PATCH FOR AGX THOR GPU =====
import sys
import os

# Force CUDA arch list BEFORE any torch imports
os.environ['TORCH_CUDA_ARCH_LIST'] = '8.0;8.6;8.9;9.0'

# Monkey patch torch.cuda.get_device_capability to return 9.0 instead of 11.0
def patch_torch_cuda():
    import torch.cuda
    original_get_device_capability = torch.cuda.get_device_capability
    
    def patched_get_device_capability(device=None):
        # Return compute capability 9.0 (Hopper) instead of 11.0 (Thor)
        # This is supported by PyTorch 2.2
        return (9, 0)
    
    torch.cuda.get_device_capability = patched_get_device_capability
    print("✓ Patched torch.cuda.get_device_capability to return (9, 0)")

# Apply patch immediately after torch is imported
import torch
patch_torch_cuda()
# ===== END MONKEY PATCH =====



